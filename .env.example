# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=tuition
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tuition
POSTGRES_PORT=5432
POSTGRES_TEST_DB=tuition_test
POSTGRES_TEST_PORT=5433

# --- Tuition API ---
DATABASE_URL=postgresql+psycopg://tuition:change-me@localhost:5432/tuition
TEST_DATABASE_URL=postgresql+psycopg://tuition:change-me@localhost:5433/tuition_test
# Shared password for the seeded demo users (student1..student4, bank1, admin1). Demo only.
SEED_DEMO_PASSWORD=demo-pass-123
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
APP_TIMEZONE=Europe/Istanbul
MOBILE_DAILY_QUERY_LIMIT=3

# --- AI Agent ---
# LLM_PROVIDER: openai | gemini. Both use the OpenAI-compatible Chat Completions API.
LLM_PROVIDER=gemini
# Leave empty for the default (gemini-3.5-flash-lite / gpt-4o-mini).
LLM_MODEL=
# Optional: override the API base URL (e.g. a local OpenAI-compatible server).
LLM_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=
# All REST calls from the agent go through the API Gateway (Kong on port 8000).
GATEWAY_BASE_URL=http://localhost:8000

# --- API Gateway (Kong) ---
# Host port of the gateway, and the Tuition API URL as seen from the gateway container.
GATEWAY_PORT=8000
API_UPSTREAM=http://api:8080

# --- Azure deployment (deploy/azure/deploy.ps1) ---
# 12+ letters and digits with an upper case letter, a lower case letter and a digit.
# For the cloud, JWT_SECRET must also be replaced with a random value of 32+ characters.
AZURE_POSTGRES_PASSWORD=
MCP_SERVER_URL=http://localhost:8001/mcp
