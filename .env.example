# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=tuition
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tuition
POSTGRES_PORT=5432
POSTGRES_TEST_DB=tuition_test
POSTGRES_TEST_PORT=5433

# --- Tuition API ---
DATABASE_URL=postgresql+psycopg://tuition:change-me@localhost:5432/tuition
TEST_DATABASE_URL=postgresql+psycopg://tuition:change-me@localhost:5433/tuition_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
APP_TIMEZONE=Europe/Istanbul
MOBILE_DAILY_QUERY_LIMIT=3

# --- AI Agent ---
# LLM_PROVIDER: openai | gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
# All REST calls from the agent go through the API Gateway.
GATEWAY_BASE_URL=http://localhost:8000
MCP_SERVER_URL=http://localhost:8001/mcp
